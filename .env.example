# Upstash Redis (injectées automatiquement par l'intégration Vercel Marketplace "Upstash for Redis")
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Clé secrète : la page des réponses est accessible sur /r/<ADMIN_KEY>
# Génère une longue chaîne aléatoire, ex : openssl rand -hex 24
ADMIN_KEY="change-moi-par-une-longue-chaine-aleatoire"
